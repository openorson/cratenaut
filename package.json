{
  "private": true,
  "name": "cratenaut",
  "description": "用 TypeScript 定义、审查并部署本地与远程服务器上的 Docker 工作负载",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openorson/cratenaut.git"
  },
  "bugs": {
    "url": "https://github.com/openorson/cratenaut/issues"
  },
  "homepage": "https://openorson.github.io/cratenaut/",
  "author": "openorson",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "test": "bun run --filter '*' test",
    "typecheck": "tsc --ignoreConfig --noEmit --target esnext --module preserve --moduleResolution bundler --allowImportingTsExtensions --types bun --strict --noUncheckedIndexedAccess scripts/release.ts && bun run --filter '*' typecheck",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run docs:build",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "docs:build": "bun run --cwd docs build",
    "docs:dev": "bun run --cwd docs dev",
    "docs:preview": "bun run --cwd docs preview",
    "changeset": "changeset",
    "release": "bun scripts/release.ts",
    "release:pack": "bun scripts/release.ts pack",
    "release:publish": "bun scripts/release.ts publish",
    "release:sync": "bun scripts/release.ts sync",
    "release:verify": "bun scripts/release.ts verify",
    "release:version": "bun scripts/release.ts version"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "bun",
    "deployment",
    "devops",
    "docker",
    "infrastructure-as-code",
    "typescript"
  ],
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/bun": "catalog:",
    "@tsconfig/bun": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-sort-package-json": "catalog:",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "packages/**/*",
      "examples/**/*"
    ],
    "catalog": {
      "@tsconfig/node22": "22.0.6",
      "@types/bun": "1.3.14",
      "@tsconfig/bun": "1.0.11",
      "@clack/prompts": "1.7.0",
      "@changesets/cli": "3.0.0",
      "typebox": "1.3.14",
      "citty": "0.2.2",
      "husky": "9.1.7",
      "lint-staged": "17.3.0",
      "nostics": "1.2.0",
      "prettier": "3.9.6",
      "prettier-plugin-sort-package-json": "1.1.0",
      "typescript": "7.0.2"
    }
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
